# 运行时状态与日志台账（严禁入库，包含HR真实对话与投递留痕）
state/*.json
state/*.jsonl
state/*.log
state/*.png
state/*.md
!state/.gitkeep

# 飞书卡片运行时留痕（与台账 human_alert_card 记录冗余）
state/feishu_cards.jsonl
# 本地敏感覆盖层（api_key、微信号、手机号等，绝不入库）
config.local.json
# 简历本地数据（含真实姓名与经历，不入库）
profile.local.json
# DPAPI 加密密文存储（绑定本机）
state/secrets.json

# 办公与简历原始文件
*.pdf
*.docx
*.doc
*.xlsx
.env
.env.*

# Python & 环境
__pycache__/
*.pyc
.venv/
state_dryrun/

